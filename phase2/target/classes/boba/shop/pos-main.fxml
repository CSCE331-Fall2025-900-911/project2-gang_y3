<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="boba.shop.PosMainController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-width: 0 0 2 0;">
         <children>
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Boba Shop POS" />
            <Button fx:id="viewOrderButton" onAction="#onViewOrder" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="View Order" />
            <Button onAction="#onManagerView" style="-fx-background-color: #666; -fx-text-fill: white;" text="Manager View" />
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
      </HBox>
   </top>
   <left>
      <VBox prefWidth="250.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-width: 0 2 0 0;">
         <children>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Current Order" />
            <ListView fx:id="orderListView" prefHeight="400.0" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <GridPane fx:id="menuGridPane" hgap="10.0" vgap="10.0" style="-fx-background-color: #f4f4f4;">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </GridPane>
   </center>
</BorderPane>