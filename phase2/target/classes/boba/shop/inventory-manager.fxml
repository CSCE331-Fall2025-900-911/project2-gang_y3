<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="boba.shop.InventoryManagerController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-width: 0 0 2 0;">
         <children>
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Boba Shop Inventory Manager" />
            <Button onAction="#onBackToPOS" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Back to POS" />
            <Button onAction="#onRefreshInventory" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Refresh" />
         </children>
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <GridPane hgap="20.0" vgap="20.0" style="-fx-background-color: #f4f4f4;">
         <children>
            <VBox spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #ddd; -fx-padding: 10;">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Milk" />
                        <Button onAction="#onSortMilkDescending" style="-fx-background-color: black; -fx-text-fill: white; -fx-font-size: 12px;" text="Sort Desc" />
                     </children>
                  </HBox>
                  <ListView fx:id="milkInventory" prefHeight="200.0" prefWidth="300.0" />
               </children>
            </VBox>
            <VBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #ddd; -fx-padding: 10;">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Boba" />
                        <Button onAction="#onSortBobaAscending" style="-fx-background-color: black; -fx-text-fill: white; -fx-font-size: 12px;" text="Sort Asc" />
                     </children>
                  </HBox>
                  <ListView fx:id="bobaInventory" prefHeight="200.0" prefWidth="300.0" />
               </children>
            </VBox>
            <VBox spacing="10.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #ddd; -fx-padding: 10;">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Utensils" />
                        <Button onAction="#onSortUtensilsAlphabetical" style="-fx-background-color: black; -fx-text-fill: white; -fx-font-size: 12px;" text="Alphabetical" />
                     </children>
                  </HBox>
                  <ListView fx:id="utensilsInventory" prefHeight="200.0" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </GridPane>
   </center>
</BorderPane>