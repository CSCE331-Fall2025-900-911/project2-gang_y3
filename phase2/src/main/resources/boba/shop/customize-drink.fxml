<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="boba.shop.CustomizeDrinkController">
   <children>
      <Label fx:id="drinkNameLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Drink Name" />
      
      <VBox spacing="10.0">
         <children>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Sweetness Level" />
            <RadioButton fx:id="sweetness0" text="0%" />
            <RadioButton fx:id="sweetness25" text="25%" />
            <RadioButton fx:id="sweetness50" text="50%" />
            <RadioButton fx:id="sweetness100" text="100%" />
         </children>
      </VBox>
      
      <VBox spacing="10.0">
         <children>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Ice Level" />
            <RadioButton fx:id="ice0" text="0%" />
            <RadioButton fx:id="ice25" text="25%" />
            <RadioButton fx:id="ice50" text="50%" />
            <RadioButton fx:id="ice100" text="100%" />
         </children>
      </VBox>
      
      <HBox spacing="10.0" alignment="CENTER">
         <children>
            <Button onAction="#onAddToCart" prefWidth="120.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16px;" text="Add to Cart" />
            <Button onAction="#onCancel" prefWidth="120.0" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 16px;" text="Cancel" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>